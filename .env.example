# scripts/setup.ps1 generates random local secrets on first run.
# This example contains placeholders only; the real .env is ignored by Git.
POSTGRES_USER=studyhub
POSTGRES_DB=studyhub
POSTGRES_PORT=5433
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+psycopg://studyhub:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5433/studyhub
JWT_SECRET=CHANGE_ME_JWT_SECRET
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
COOKIE_SECURE=false
BOOTSTRAP_TEACHER_EMAIL=teacher@example.com
BOOTSTRAP_TEACHER_PASSWORD=CHANGE_ME_TEACHER_PASSWORD
BOOTSTRAP_TEACHER_DISPLAY_NAME=Giảng viên demo
DEMO_STUDENT_EMAIL=student@example.com
DEMO_STUDENT_PASSWORD=CHANGE_ME_STUDENT_PASSWORD
DEMO_STUDENT_DISPLAY_NAME=Sinh viên demo
COURSE_RUN_CODE=MOBILE_2026
# Leave empty to use the current date in Asia/Bangkok for the real run.
COURSE_RUN_START_DATE=
# Optional local override; Docker uses /models/current (read-only mount).
# MODEL_ARTIFACT_PATH=C:/path/to/studyhub/ml/artifacts/current
# Gemini receives questions + up to four reviewed source chunks, not entire PDFs.
# Fill the key only in your ignored .env; never in frontend source.
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL_PATH=.local/embedding
CHAT_TIMEOUT_SECONDS=45
